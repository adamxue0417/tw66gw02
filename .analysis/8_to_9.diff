+#include "config.h"
+#include "ota.h"
+#include "ota_layout.h"
+#include "ota_crc.h"
+#include "ota_metadata.h"
+#include <string.h>
+
+#define OTA_ACCEPTED_CHUNK_SIZE 128U
+#define OTA_TIMEOUT_TICKS       3000U
+#define OTA_CONFIRM_TICKS       1500U
+#define OTA_STATUS_QUEUE_DEPTH  4U
+
+typedef char OtaProtocolPayloadLimitCheck[
+    ((OTA_PROTOCOL_CHUNK_DATA_MAX + OTA_CHUNK_OFFSET_SIZE) <= MATHIS_MAX_PAYLOAD) ? 1 : -1];
+typedef char OtaAcceptedChunkLimitCheck[
+    (OTA_ACCEPTED_CHUNK_SIZE <= OTA_PROTOCOL_CHUNK_DATA_MAX) ? 1 : -1];
+
+typedef struct { uint8_t length; uint8_t data[6]; } OtaStatusEntry;
+
+static OtaPersistentState s_persist;
+static OtaStatusEntry s_status_queue[OTA_STATUS_QUEUE_DEPTH];
+static uint8_t s_status_head, s_status_tail, s_status_count;
+static uint16_t s_timeout_ticks, s_confirm_ticks;
+static uint32_t s_last_offset;
+static uint16_t s_last_length;
+static uint8_t s_reset_pending, s_telemetry_transmitted;
+
+static uint32_t read_le32(const uint8_t *data)
+{
+    return (uint32_t)data[0] | ((uint32_t)data[1] << 8) |
+           ((uint32_t)data[2] << 16) | ((uint32_t)data[3] << 24);
+}
+
+static void queue_status(uint8_t status, uint32_t extra, uint8_t extra_length)
+{
+    OtaStatusEntry *entry;
+    uint8_t i;
+    if (s_status_count >= OTA_STATUS_QUEUE_DEPTH) { return; }
+    entry = &s_status_queue[s_status_tail];
+    entry->data[0] = status; entry->length = (uint8_t)(1U + extra_length);
+    for (i = 0U; i < extra_length; ++i) { entry->data[1U + i] = (uint8_t)(extra >> (8U * i)); }
+    s_status_tail = (uint8_t)((s_status_tail + 1U) % OTA_STATUS_QUEUE_DEPTH); ++s_status_count;
+}
+
+static uint8_t persist_state(void)
+{
+    ++s_persist.generation;
+    return OtaMetadataWrite(OTA_RECORD_STATE, &s_persist, sizeof(s_persist));
+}
+
+static uint8_t erase_staging(void)
+{
+    FLASH_EraseInitTypeDef erase;
+    uint32_t page_error = 0U;
+    erase.TypeErase = FLASH_TYPEERASE_PAGES; erase.PageAddress = OTA_SLOT_B_BASE; erase.NbPages = OTA_SLOT_PAGE_COUNT;
+    if (HAL_FLASH_Unlock() != HAL_OK) { return 0U; }
+    if (HAL_FLASHEx_Erase(&erase, &page_error) != HAL_OK) { HAL_FLASH_Lock(); return 0U; }
+    HAL_FLASH_Lock(); return 1U;
+}
+
+static uint8_t write_chunk(uint32_t offset, const uint8_t *data, uint16_t length)
+{
+    uint16_t i, halfword;
+    uint32_t address = OTA_SLOT_B_BASE + offset;
+    if (HAL_FLASH_Unlock() != HAL_OK) { return 0U; }
+    for (i = 0U; i < length; i += 2U) {
+        halfword = data[i];
+        halfword |= ((i + 1U) < length) ? ((uint16_t)data[i + 1U] << 8) : 0xFF00U;
+        if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_HALFWORD, address + i, halfword) != HAL_OK) {
+            HAL_FLASH_Lock(); return 0U;
+        }
+    }
+    HAL_FLASH_Lock(); return (memcmp((const void *)address, data, length) == 0) ? 1U : 0U;
+}
+
+static uint8_t battery_percent(void)
+{
+    if (g_battery_mv <= 1100U) { return 0U; }
+    if (g_battery_mv >= 1500U) { return 100U; }
+    return (uint8_t)(((uint32_t)(g_battery_mv - 1100U) * 100U) / 400U);
+}
+
+static void reset_download_state(void)
+{
+    s_persist.state = OTA_PERSIST_IDLE;
+    s_persist.expected_artifact_size = 0U; s_persist.expected_crc32 = 0U; s_persist.next_offset = 0U;
+    (void)persist_state(); s_timeout_ticks = 0U;
+}
+
+static void abort_transfer(uint8_t reason)
+{
+    reset_download_state(); queue_status(OTA_STATUS_ABORTED, reason, 1U);
+}
+
+static void handle_begin(const uint8_t *payload, uint16_t length)
+{
+    uint32_t image_size;
+    if (length != 9U) { queue_status(OTA_STATUS_STORAGE, 0U, 0U); return; }
+    if ((s_persist.state != OTA_PERSIST_IDLE) && (s_persist.state != OTA_PERSIST_CONFIRMED)) {
+        queue_status(OTA_STATUS_BUSY, 0U, 0U); return;
+    }
+    if ((g_battery_low != 0U) || (battery_percent() < 30U)) { queue_status(OTA_STATUS_POWER, 0U, 0U); return; }
+    if (work_process != idle) { queue_status(OTA_STATUS_BUSY, 0U, 0U); return; }
+    image_size = read_le32(payload);
+    if ((image_size <= OTA_RSA_SIGNATURE_SIZE) || (image_size > OTA_SLOT_SIZE)) {
+        queue_status(OTA_STATUS_VERIFY_FAIL, OTA_FAIL_TOO_LARGE, 1U); return;
+    }
+    if (erase_staging() == 0U) { queue_status(OTA_STATUS_STORAGE, 0U, 0U); return; }
+    s_persist.state = OTA_PERSIST_DOWNLOADING;
+    s_persist.expected_artifact_size = image_size; s_persist.expected_crc32 = read_le32(&payload[4]);
+    s_persist.target_firmware_version = payload[8]; s_persist.next_offset = 0U;
+    s_last_offset = 0xFFFFFFFFUL; s_last_length = 0U; s_timeout_ticks = 0U;
+    if (persist_state() == 0U) {
+        s_persist.state = OTA_PERSIST_IDLE; s_persist.expected_artifact_size = 0U;
+        s_persist.expected_crc32 = 0U; s_persist.next_offset = 0U;
+        queue_status(OTA_STATUS_STORAGE, 0U, 0U); return;
+    }
+    queue_status(OTA_STATUS_READY, OTA_ACCEPTED_CHUNK_SIZE, 2U);
+}
+
+static void handle_chunk(const uint8_t *payload, uint16_t length)
+{
+    uint32_t offset;
+    uint16_t data_length;
+    if ((s_persist.state != OTA_PERSIST_DOWNLOADING) || (length <= OTA_CHUNK_OFFSET_SIZE)) {
+        queue_status(OTA_STATUS_BAD_OFFSET, 0U, 0U); return;
+    }
+    offset = read_le32(payload); data_length = (uint16_t)(length - OTA_CHUNK_OFFSET_SIZE);
+    if ((data_length > OTA_ACCEPTED_CHUNK_SIZE) || ((offset + data_length) > s_persist.expected_artifact_size)) {
+        queue_status(OTA_STATUS_BAD_OFFSET, 0U, 0U); return;
+    }
+    if (offset != s_persist.next_offset) {
+        if ((offset == s_last_offset) && (data_length == s_last_length) &&
+            (memcmp((const void *)(OTA_SLOT_B_BASE + offset), &payload[4], data_length) == 0)) {
+            queue_status(OTA_STATUS_ACK, s_persist.next_offset, 4U);
+        } else { queue_status(OTA_STATUS_BAD_OFFSET, 0U, 0U); }
+        return;
+    }
+    if (write_chunk(offset, &payload[4], data_length) == 0U) { queue_status(OTA_STATUS_STORAGE, 0U, 0U); return; }
+    s_last_offset = offset; s_last_length = data_length; s_persist.next_offset += data_length; s_timeout_ticks = 0U;
+    queue_status(OTA_STATUS_ACK, s_persist.next_offset, 4U);
+}
+
+static void verify_failed(uint8_t reason)
+{
+    queue_status(OTA_STATUS_VERIFY_FAIL, reason, 1U);
+    reset_download_state();
+}
+
+static void handle_commit(const uint8_t *payload, uint16_t length)
+{
+    OtaImageHeader header;
+    OtaVerifyResult verify;
+    uint32_t commit_crc;
+    if ((s_persist.state != OTA_PERSIST_DOWNLOADING) || (length != 4U)) {
+        verify_failed(OTA_FAIL_UNKNOWN); return;
+    }
+    commit_crc = read_le32(payload);
+    if ((commit_crc != s_persist.expected_crc32) || (s_persist.next_offset != s_persist.expected_artifact_size) ||
+        (OtaCrc32((const void *)OTA_SLOT_B_BASE, s_persist.expected_artifact_size) != commit_crc)) {
+        verify_failed(OTA_FAIL_CRC); return;
+    }
+    if ((OTA_BOOT_API->magic != OTA_BOOT_API_MAGIC) || (OTA_BOOT_API->abi_version != OTA_BOOT_API_VERSION) ||
+        (OTA_BOOT_API->verify_artifact == 0)) { verify_failed(OTA_FAIL_SIGNATURE); return; }
+    verify = OTA_BOOT_API->verify_artifact(OTA_SLOT_B_BASE, s_persist.expected_artifact_size,
+                                           commit_crc, s_persist.highest_security_version, &header);
+    if ((verify != OTA_VERIFY_OK) || (header.firmware_version != s_persist.target_firmware_version)) {
+        verify_failed((verify == OTA_VERIFY_ROLLBACK) ? OTA_FAIL_ROLLBACK : OTA_FAIL_SIGNATURE); return;
+    }
+    s_persist.state = OTA_PERSIST_VERIFIED_PENDING_SWAP;
+    s_persist.slot_b.artifact_size = s_persist.expected_artifact_size; s_persist.slot_b.artifact_crc32 = commit_crc;
+    s_persist.slot_b.security_version = header.security_version; s_persist.slot_b.firmware_version = header.firmware_version;
+    s_persist.slot_b.valid = 1U;
+    if (persist_state() == 0U) {
+        s_persist.state = OTA_PERSIST_IDLE; s_persist.expected_artifact_size = 0U;
+        s_persist.expected_crc32 = 0U; s_persist.next_offset = 0U;
+        queue_status(OTA_STATUS_STORAGE, 0U, 0U); return;
+    }
+    queue_status(OTA_STATUS_VERIFY_OK, 0U, 0U); queue_status(OTA_STATUS_APPLYING, 0U, 0U); s_reset_pending = 1U;
+}
+
+void Ota_Init(void)
+{
+    memset(&s_persist, 0, sizeof(s_persist));
+    if (OtaMetadataRead(OTA_RECORD_STATE, &s_persist, sizeof(s_persist)) == 0U) { s_persist.state = OTA_PERSIST_IDLE; }
+    s_status_head = s_status_tail = s_status_count = 0U; s_timeout_ticks = s_confirm_ticks = 0U;
+    s_reset_pending = s_telemetry_transmitted = 0U; s_last_offset = 0xFFFFFFFFUL; s_last_length = 0U;
+}
+
+void Ota_HandleMessage(uint8_t type, const uint8_t *payload, uint16_t length)
+{
+    if ((payload == 0) && (length != 0U)) { return; }
+    if (type == MATHIS_TYPE_OTA_BEGIN) { handle_begin(payload, length); }
+    else if (type == MATHIS_TYPE_OTA_CHUNK) { handle_chunk(payload, length); }
+    else if (type == MATHIS_TYPE_OTA_COMMIT) { handle_commit(payload, length); }
+    else if ((type == MATHIS_TYPE_OTA_ABORT) && (length == 0U)) { abort_transfer(0U); }
+}
+
+void Ota_Task20ms(void)
+{
+    IWDG->KR = 0xAAAAU;
+    if ((s_persist.state == OTA_PERSIST_DOWNLOADING) && (++s_timeout_ticks >= OTA_TIMEOUT_TICKS)) {
+        abort_transfer(OTA_FAIL_TIMEOUT);
+    }
+    if (s_persist.state == OTA_PERSIST_INSTALLED_PENDING_CONFIRM) {
+        if (s_confirm_ticks < OTA_CONFIRM_TICKS) { ++s_confirm_ticks; }
+        if ((s_confirm_ticks >= OTA_CONFIRM_TICKS) && (s_telemetry_transmitted != 0U)) {
+            s_persist.state = OTA_PERSIST_CONFIRMED; s_persist.boot_attempts = 0U;
+            s_persist.highest_security_version = s_persist.slot_a.security_version; (void)persist_state();
+        }
+    }
+}
+
+uint8_t Ota_PollStatus(uint8_t *payload, uint8_t *length)
+{
+    OtaStatusEntry *entry;
+    if ((payload == 0) || (length == 0) || (s_status_count == 0U)) { return 0U; }
+    entry = &s_status_queue[s_status_head]; memcpy(payload, entry->data, entry->length); *length = entry->length;
+    s_status_head = (uint8_t)((s_status_head + 1U) % OTA_STATUS_QUEUE_DEPTH); --s_status_count; return 1U;
+}
+
+uint8_t Ota_TelemetryPaused(void)
+{
+    return ((s_persist.state == OTA_PERSIST_DOWNLOADING) ||
+            (s_persist.state == OTA_PERSIST_VERIFIED_PENDING_SWAP)) ? 1U : 0U;
+}
+
+uint8_t Ota_ResetPending(void) { return s_reset_pending; }
+void Ota_NotifyTelemetryTransmitted(void) { s_telemetry_transmitted = 1U; }
