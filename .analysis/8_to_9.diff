+#include "ota_metadata.h"
+#include "ota_crc.h"
+#include "stm32f0xx_hal.h"
+#include <stddef.h>
+#include <string.h>
+
+#define META_MAGIC       0x3141544DUL /* "MTA1" */
+#define META_SCHEMA      1U
+#define META_COMMIT      0xA55AU
+#define META_RECORD_SIZE 96U
+#define META_PER_PAGE    (OTA_META_PAGE_SIZE / META_RECORD_SIZE)
+
+typedef struct {
+    uint32_t magic;
+    uint16_t schema;
+    uint16_t type;
+    uint32_t sequence;
+    uint16_t payload_length;
+    uint16_t reserved;
+    uint8_t payload[OTA_METADATA_PAYLOAD_MAX];
+    uint32_t crc32;
+    uint16_t commit;
+    uint16_t padding;
+} MetaRecord;
+
+typedef char MetaRecordSizeCheck[(sizeof(MetaRecord) == META_RECORD_SIZE) ? 1 : -1];
+typedef char OtaStateSizeCheck[(sizeof(OtaPersistentState) <= OTA_METADATA_PAYLOAD_MAX) ? 1 : -1];
+typedef char OtaConfigSizeCheck[(sizeof(OtaPersistentConfig) <= OTA_METADATA_PAYLOAD_MAX) ? 1 : -1];
+
+static uint8_t record_valid(const MetaRecord *record)
+{
+    uint32_t crc;
+    if ((record->magic != META_MAGIC) || (record->schema != META_SCHEMA) ||
+        (record->commit != META_COMMIT) || (record->payload_length > OTA_METADATA_PAYLOAD_MAX) ||
+        ((record->type != OTA_RECORD_CONFIG) && (record->type != OTA_RECORD_STATE))) {
+        return 0U;
+    }
+    crc = OtaCrc32(record, (uint32_t)offsetof(MetaRecord, crc32));
+    return (crc == record->crc32) ? 1U : 0U;
+}
+
+static const MetaRecord *latest_record(OtaRecordType type)
+{
+    const uint32_t pages[2] = { OTA_META_A_BASE, OTA_META_B_BASE };
+    const MetaRecord *best = 0;
+    uint8_t page;
+    uint8_t slot;
+    for (page = 0U; page < 2U; ++page) {
+        for (slot = 0U; slot < META_PER_PAGE; ++slot) {
+            const MetaRecord *record = (const MetaRecord *)(pages[page] + ((uint32_t)slot * META_RECORD_SIZE));
+            if ((record_valid(record) != 0U) && (record->type == (uint16_t)type) &&
+                ((best == 0) || ((int32_t)(record->sequence - best->sequence) > 0))) {
+                best = record;
+            }
+        }
+    }
+    return best;
+}
+
+static uint8_t flash_erase_page(uint32_t address)
+{
+    FLASH_EraseInitTypeDef erase;
+    uint32_t page_error = 0U;
+    erase.TypeErase = FLASH_TYPEERASE_PAGES;
+    erase.PageAddress = address;
+    erase.NbPages = 1U;
+    return (HAL_FLASHEx_Erase(&erase, &page_error) == HAL_OK) ? 1U : 0U;
+}
+
+static uint8_t flash_write_record(uint32_t address, const MetaRecord *record)
+{
+    const uint16_t *source = (const uint16_t *)record;
+    uint16_t offset;
+    for (offset = 0U; offset < (uint16_t)offsetof(MetaRecord, commit); offset += 2U) {
+        if (HAL_FLASH_Program(FLASH_TYPEPROGRAM_HALFWORD, address + offset, source[offset / 2U]) != HAL_OK) {
+            return 0U;
+        }
+    }
+    return (HAL_FLASH_Program(FLASH_TYPEPROGRAM_HALFWORD,
+                              address + (uint32_t)offsetof(MetaRecord, commit), META_COMMIT) == HAL_OK) ? 1U : 0U;
+}
+
+static uint8_t find_free(uint32_t page_address, uint8_t *slot_out)
+{
+    uint8_t slot;
+    for (slot = 0U; slot < META_PER_PAGE; ++slot) {
+        const uint32_t *word = (const uint32_t *)(page_address + ((uint32_t)slot * META_RECORD_SIZE));
+        if (*word == 0xFFFFFFFFUL) { *slot_out = slot; return 1U; }
+    }
+    return 0U;
+}
+
+static void make_record(MetaRecord *record, OtaRecordType type, const void *payload,
+                        uint16_t payload_size, uint32_t sequence)
+{
+    memset(record, 0xFF, sizeof(*record));
+    record->magic = META_MAGIC;
+    record->schema = META_SCHEMA;
+    record->type = (uint16_t)type;
+    record->sequence = sequence;
+    record->payload_length = payload_size;
+    memcpy(record->payload, payload, payload_size);
+    record->crc32 = OtaCrc32(record, (uint32_t)offsetof(MetaRecord, crc32));
+    record->commit = META_COMMIT;
+}
+
+uint8_t OtaMetadataRead(OtaRecordType type, void *payload, uint16_t payload_size)
+{
+    const MetaRecord *record = latest_record(type);
+    if ((record == 0) || (payload == 0) || (record->payload_length != payload_size)) { return 0U; }
+    memcpy(payload, record->payload, payload_size);
+    return 1U;
+}
+
+uint8_t OtaMetadataWrite(OtaRecordType type, const void *payload, uint16_t payload_size)
+{
+    const MetaRecord *latest_config;
+    const MetaRecord *latest_state;
+    const MetaRecord *latest_any;
+    MetaRecord record;
+    MetaRecord keeper_copy[2];
+    uint8_t keeper_valid[2] = { 0U, 0U };
+    uint32_t active_page = OTA_META_A_BASE;
+    uint32_t other_page = OTA_META_B_BASE;
+    uint32_t sequence = 1U;
+    uint8_t slot;
+    uint8_t result = 0U;
+
+    if ((payload == 0) || (payload_size > OTA_METADATA_PAYLOAD_MAX)) { return 0U; }
+    latest_config = latest_record(OTA_RECORD_CONFIG);
+    latest_state = latest_record(OTA_RECORD_STATE);
+    latest_any = latest_config;
+    if ((latest_any == 0) || ((latest_state != 0) && ((int32_t)(latest_state->sequence - latest_any->sequence) > 0))) {
+        latest_any = latest_state;
+    }
+    if (latest_any != 0) {
+        uint32_t address = (uint32_t)latest_any;
+        sequence = latest_any->sequence + 1U;
+        active_page = (address < OTA_META_B_BASE) ? OTA_META_A_BASE : OTA_META_B_BASE;
+        other_page = (active_page == OTA_META_A_BASE) ? OTA_META_B_BASE : OTA_META_A_BASE;
+    }
+    make_record(&record, type, payload, payload_size, sequence);
+    if (latest_config != 0) { memcpy(&keeper_copy[0], latest_config, sizeof(MetaRecord)); keeper_valid[0] = 1U; }
+    if (latest_state != 0) { memcpy(&keeper_copy[1], latest_state, sizeof(MetaRecord)); keeper_valid[1] = 1U; }
+
+    if (HAL_FLASH_Unlock() != HAL_OK) { return 0U; }
+    if (find_free(active_page, &slot) != 0U) {
+        result = flash_write_record(active_page + ((uint32_t)slot * META_RECORD_SIZE), &record);
+    } else if (flash_erase_page(other_page) != 0U) {
+        uint8_t next_slot = 0U;
+        uint8_t i;
+        result = 1U;
+        for (i = 0U; i < 2U; ++i) {
+            if ((keeper_valid[i] != 0U) && (keeper_copy[i].type != (uint16_t)type)) {
+                if (flash_write_record(other_page + ((uint32_t)next_slot * META_RECORD_SIZE), &keeper_copy[i]) == 0U) {
+                    result = 0U; break;
+                }
+                ++next_slot;
+            }
+        }
+        if ((result != 0U) && (flash_write_record(other_page + ((uint32_t)next_slot * META_RECORD_SIZE), &record) == 0U)) {
+            result = 0U;
+        }
+        if (result != 0U) { (void)flash_erase_page(active_page); }
+    }
+    HAL_FLASH_Lock();
+    return result;
+}
+
+uint8_t OtaMetadataEraseAll(void)
+{
+    uint8_t ok;
+    if (HAL_FLASH_Unlock() != HAL_OK) { return 0U; }
+    ok = flash_erase_page(OTA_META_A_BASE);
+    if (flash_erase_page(OTA_META_B_BASE) == 0U) { ok = 0U; }
+    HAL_FLASH_Lock();
+    return ok;
+}
