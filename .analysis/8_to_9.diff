@@ -0,0 +1,20 @@
+#include "ota_crc.h"
+
+uint32_t OtaCrc32Update(uint32_t crc, const uint8_t *data, uint32_t length)
+{
+    uint32_t i;
+    uint8_t bit;
+    crc = ~crc;
+    for (i = 0U; i < length; ++i) {
+        crc ^= data[i];
+        for (bit = 0U; bit < 8U; ++bit) {
+            crc = ((crc & 1U) != 0U) ? ((crc >> 1) ^ 0xEDB88320UL) : (crc >> 1);
+        }
+    }
+    return ~crc;
+}
+
+uint32_t OtaCrc32(const void *data, uint32_t length)
+{
+    return OtaCrc32Update(0U, (const uint8_t *)data, length);
+}
