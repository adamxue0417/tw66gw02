+    }
+
+    if (temp_f <= 100) { return 0x01u; }
+    if (temp_f <= 167) { return 0x02u; }
+    if (temp_f <= 234) { return 0x03u; }
+    if (temp_f <= 300) { return 0x04u; }
+    if (temp_f <= 367) { return 0x05u; }
+    if (temp_f <= 434) { return 0x06u; }
+    return 0x07u;
