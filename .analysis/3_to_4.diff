+{
+    uint8_t i;
+
+    if ((src_idx >= TEMP_COEFF_CHANNEL_COUNT) || (coeff == 0)) {
+        return 0u;
+    }
+
+    for (i = 0u; i < TEMP_COEFF_TERM_COUNT; i++) {
+        s_temp_coeff[src_idx][i] = coeff[i];
+    }
+    return 1u;
