+    g_mathis_ble_debug.last_type = frame[2];
+    g_mathis_ble_debug.last_sequence = frame[3];
+    g_mathis_ble_debug.last_payload_length = payload_length;
+    if (length != (uint16_t)(payload_length + 8u)) {
+        g_mathis_ble_debug.length_errors++;
