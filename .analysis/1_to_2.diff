-    hi2c->Instance->CR1 &= ~I2C_CR1_TXDMAEN;
-  }
-  else if (I2C_CHECK_IT_SOURCE(tmpcr1value, I2C_CR1_RXDMAEN) != RESET)
-  {
-    /* Disable DMA Request */
-    hi2c->Instance->CR1 &= ~I2C_CR1_RXDMAEN;
-  }
-  else
-  {
-    /* Do nothing */
-  }
-
