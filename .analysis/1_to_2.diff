-            work_process = start_up;
-            UI_NotifyLocalInteraction();
-            break;
-
-        case shutdown:
-            break;
-
-        default:
-            if ((IsDisplayDashOnlyAlarm() == 0u) && (g_probe_connected != 0u)) {
