-#define __HAL_UART_ENABLE_IT(__HANDLE__, __INTERRUPT__)   (\
-                                                           ((((uint8_t)(__INTERRUPT__)) >> 5U) == 1U)?\
-                                                           ((__HANDLE__)->Instance->CR1 |= (1U <<\
-                                                               ((__INTERRUPT__) & UART_IT_MASK))): \
