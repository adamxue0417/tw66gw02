-    s_tx[4] = 0x00u; s_tx[5] = 0x00u; s_tx[6] = 0x00u;
-    s_tx[7] = 0x00u; s_tx[8] = 0x00u; s_tx[9] = 0x00u; s_tx[10] = 0x00u; s_tx[11] = 0x00u;
