-    else { wl_split3(p, &h, &t, &l); }
-
-    s_tx[0] = WL_HEAD; s_tx[1] = WL_CMD_QUERY_PROBE; s_tx[2] = rx[2];
-    s_tx[3] = 0x00u; s_tx[4] = 0x00u; s_tx[5] = 0x00u;
-    s_tx[6] = h; s_tx[7] = t; s_tx[8] = l; s_tx[9] = WL_TAIL;
