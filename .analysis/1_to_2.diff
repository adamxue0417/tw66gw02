-    s_tx[15] = WL_TAIL;
-    wl_send(s_tx, 16u);
-
-    s_tx[0] = WL_HEAD; s_tx[1] = 0x3Bu;
-    s_tx[2] = 0x09u; s_tx[3] = 0x06u; s_tx[4] = 0x00u; /* probe2 unsupported */
