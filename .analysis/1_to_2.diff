-    no_main_temp = (IsMainTempInvalid(system_data.pt1000_temp[0]) != 0u) &&
-                   (IsMainTempInvalid(system_data.pt1000_temp[1]) != 0u) &&
-                   (IsMainTempInvalid(system_data.pt1000_temp[2]) != 0u);
