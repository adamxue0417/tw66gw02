-    wl_split3(system_data.InTempSet, &h, &t, &l);
-    s_tx[0] = WL_HEAD; s_tx[1] = WL_CMD_JUMP_SET; s_tx[2] = rx[2];
-    s_tx[3] = h; s_tx[4] = t; s_tx[5] = l; s_tx[6] = WL_TAIL;
