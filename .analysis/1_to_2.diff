-static void I2C_DMAMasterTransmitCplt(DMA_HandleTypeDef *hdma)
-{
-  /* Derogation MISRAC2012-Rule-11.5 */
-  I2C_HandleTypeDef *hi2c = (I2C_HandleTypeDef *)(((DMA_HandleTypeDef *)hdma)->Parent);
