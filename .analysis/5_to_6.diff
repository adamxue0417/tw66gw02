+/*
+ * STM32F030C8 64 KB flash partition:
+ * 0x08000000 - 0x08000FFF  Bootloader, factory programmed and protected
+ * 0x08001000 - 0x080083FF  Active application, 29 KB
+ * 0x08008400 - 0x0800F7FF  OTA staging image, 29 KB
+ * 0x0800F800 - 0x0800FBFF  OTA metadata, 1 KB
+ * 0x0800FC00 - 0x0800FFFF  Reserved, 1 KB
+ *
+ * The application is linked at OTA_APP_BASE. The bootloader must validate
+ * OTA_METADATA_BASE and copy OTA_STAGING_BASE to OTA_APP_BASE on reset.
+ */
+#define OTA_FLASH_BASE             0x08000000UL
+#define OTA_FLASH_SIZE             0x00010000UL
+#define OTA_FLASH_PAGE_SIZE        0x00000400UL
+
+#define OTA_BOOT_BASE              0x08000000UL
+#define OTA_BOOT_SIZE              0x00001000UL
+#define OTA_APP_BASE               0x08001000UL
+#define OTA_APP_SIZE               0x00007400UL
+#define OTA_STAGING_BASE           0x08008400UL
+#define OTA_STAGING_SIZE           0x00007400UL
+#define OTA_METADATA_BASE          0x0800F800UL
+#define OTA_METADATA_SIZE          0x00000400UL
+
+#define OTA_CMD_GROUP              0x40u
+#define OTA_CMD_START              0x01u
+#define OTA_CMD_DATA               0x02u
+#define OTA_CMD_FINISH             0x03u
+#define OTA_CMD_STATUS             0x04u
+#define OTA_CMD_ABORT              0x05u
+
+#define OTA_ACK_OK                 0x00u
+#define OTA_ACK_BUSY               0x01u
+#define OTA_ACK_FORMAT_ERR         0x02u
+#define OTA_ACK_SIZE_ERR           0x03u
+#define OTA_ACK_SEQ_ERR            0x04u
+#define OTA_ACK_FLASH_ERR          0x05u
+#define OTA_ACK_CRC_ERR            0x06u
+#define OTA_ACK_STATE_ERR          0x07u
+
+#define OTA_META_MAGIC             0x544F5441UL  /* "TOTA" */
+#define OTA_META_FLAG_PENDING      0x00000001UL
+
+typedef enum {
+    OTA_STATE_IDLE = 0,
+    OTA_STATE_RECEIVING,
+    OTA_STATE_READY,
+    OTA_STATE_FAILED
+} OTA_State;
+
+typedef struct {
+    uint32_t magic;
