+/*
+ * Minimal OTA bootloader reference for STM32F030C8Tx.
+ * Build this as a separate factory-programmed image at 0x08000000.
+ */
+#include "stm32f0xx_hal.h"
+#include <stdint.h>
+#include <string.h>
+
+#define BL_FLASH_PAGE_SIZE        0x00000400UL
+#define BL_APP_BASE               0x08001000UL
+#define BL_APP_SIZE               0x00007400UL
+#define BL_STAGING_BASE           0x08008400UL
+#define BL_STAGING_SIZE           0x00007400UL
+#define BL_METADATA_BASE          0x0800F800UL
+#define BL_METADATA_SIZE          0x00000400UL
+#define BL_META_MAGIC             0x544F5441UL
+#define BL_META_FLAG_PENDING      0x00000001UL
+#define BL_VECTOR_WORDS           48UL
+
+typedef struct {
+    uint32_t magic;
+    uint32_t flags;
+    uint32_t image_addr;
+    uint32_t image_size;
+    uint32_t image_crc32;
+    uint32_t version;
+    uint32_t reserved;
+    uint32_t metadata_crc32;
+} BL_Metadata;
+
+typedef void (*pFunction)(void);
+
+static uint32_t bl_crc32_update(uint32_t crc, const uint8_t *data, uint32_t len)
+{
+    uint32_t i;
+    uint8_t bit;
+
+    crc = ~crc;
+    for (i = 0; i < len; i++) {
+        crc ^= data[i];
+        for (bit = 0; bit < 8; bit++) {
+            crc = ((crc & 1U) != 0U) ? ((crc >> 1) ^ 0xEDB88320UL) : (crc >> 1);
+        }
+    }
+    return ~crc;
+}
+
+static uint32_t bl_crc32_flash(uint32_t addr, uint32_t len)
+{
+    return bl_crc32_update(0U, (const uint8_t *)addr, len);
+}
+
+static HAL_StatusTypeDef bl_erase_pages(uint32_t addr, uint32_t size)
+{
+    FLASH_EraseInitTypeDef erase;
+    uint32_t page_error = 0U;
+
+    erase.TypeErase = FLASH_TYPEERASE_PAGES;
+    erase.PageAddress = addr;
+    erase.NbPages = (size + BL_FLASH_PAGE_SIZE - 1U) / BL_FLASH_PAGE_SIZE;
+    return HAL_FLASHEx_Erase(&erase, &page_error);
+}
+
+static HAL_StatusTypeDef bl_program_bytes(uint32_t addr, const uint8_t *data, uint32_t len)
+{
+    uint32_t i;
+    uint16_t halfword;
+    HAL_StatusTypeDef ret;
+
+    for (i = 0; i < len; i += 2U) {
+        halfword = data[i];
+        halfword |= ((i + 1U) < len) ? ((uint16_t)data[i + 1U] << 8) : 0xFF00U;
+        ret = HAL_FLASH_Program(FLASH_TYPEPROGRAM_HALFWORD, addr + i, halfword);
+        if (ret != HAL_OK) {
+            return ret;
+        }
+    }
+    return HAL_OK;
+}
+
+static uint8_t bl_metadata_valid(const BL_Metadata *meta)
+{
+    uint32_t crc;
+
+    if (meta->magic != BL_META_MAGIC) {
+        return 0U;
+    }
+    if ((meta->flags & BL_META_FLAG_PENDING) == 0U) {
+        return 0U;
+    }
+    if ((meta->image_addr != BL_STAGING_BASE) || (meta->image_size == 0U) || (meta->image_size > BL_APP_SIZE)) {
+        return 0U;
+    }
+    crc = bl_crc32_update(0U, (const uint8_t *)meta, sizeof(BL_Metadata) - sizeof(meta->metadata_crc32));
+    return (crc == meta->metadata_crc32) ? 1U : 0U;
+}
+
+static void bl_clear_metadata(void)
+{
+    HAL_FLASH_Unlock();
+    (void)bl_erase_pages(BL_METADATA_BASE, BL_METADATA_SIZE);
+    HAL_FLASH_Lock();
+}
+
+static void bl_install_if_pending(void)
+{
+    const BL_Metadata *meta = (const BL_Metadata *)BL_METADATA_BASE;
+    HAL_StatusTypeDef ret;
+
+    if (bl_metadata_valid(meta) == 0U) {
+        return;
+    }
+    if (bl_crc32_flash(BL_STAGING_BASE, meta->image_size) != meta->image_crc32) {
+        bl_clear_metadata();
+        return;
+    }
+
+    HAL_FLASH_Unlock();
+    ret = bl_erase_pages(BL_APP_BASE, BL_APP_SIZE);
+    if (ret == HAL_OK) {
+        ret = bl_program_bytes(BL_APP_BASE, (const uint8_t *)BL_STAGING_BASE, meta->image_size);
+    }
+    HAL_FLASH_Lock();
+
+    if ((ret == HAL_OK) && (bl_crc32_flash(BL_APP_BASE, meta->image_size) == meta->image_crc32)) {
+        bl_clear_metadata();
+    }
+}
+
+static uint8_t bl_app_valid(void)
+{
+    uint32_t sp = *(uint32_t *)BL_APP_BASE;
+    uint32_t reset = *(uint32_t *)(BL_APP_BASE + 4U);
+
+    if ((sp < 0x20000000UL) || (sp > 0x20002000UL)) {
+        return 0U;
+    }
+    if ((reset < BL_APP_BASE) || (reset >= (BL_APP_BASE + BL_APP_SIZE))) {
+        return 0U;
+    }
+    return 1U;
+}
+
+static void bl_jump_to_app(void)
+{
+    uint32_t i;
+    uint32_t *src = (uint32_t *)BL_APP_BASE;
+    uint32_t *dst = (uint32_t *)0x20000000UL;
+    pFunction app_reset;
+
+    for (i = 0; i < BL_VECTOR_WORDS; i++) {
+        dst[i] = src[i];
+    }
+
+    __disable_irq();
+    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;
+    SYSCFG->CFGR1 &= (uint32_t)~SYSCFG_CFGR1_MEM_MODE;
+    SYSCFG->CFGR1 |= SYSCFG_CFGR1_MEM_MODE;
+
+    __set_MSP(*(uint32_t *)BL_APP_BASE);
+    app_reset = (pFunction)*(uint32_t *)(BL_APP_BASE + 4U);
+    __enable_irq();
+    app_reset();
+}
+
+int main(void)
+{
+    HAL_Init();
+    bl_install_if_pending();
+
+    if (bl_app_valid() != 0U) {
+        bl_jump_to_app();
+    }
+
+    while (1) {
+    }
+}
