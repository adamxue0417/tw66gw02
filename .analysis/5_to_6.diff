+#include "config.h"
+
+typedef struct {
+    OTA_State state;
+    uint32_t expected_size;
+    uint32_t expected_crc32;
+    uint32_t running_crc32;
+    uint32_t received_size;
+    uint32_t version;
+    uint16_t expected_seq;
+    uint8_t last_status;
+} OTA_Context;
+
+static OTA_Context s_ota;
+
+static uint16_t ota_read_be16(const uint8_t *p)
+{
+    return (uint16_t)(((uint16_t)p[0] << 8) | p[1]);
+}
+
+static uint32_t ota_read_be32(const uint8_t *p)
+{
+    return ((uint32_t)p[0] << 24) |
+           ((uint32_t)p[1] << 16) |
+           ((uint32_t)p[2] << 8)  |
+           ((uint32_t)p[3]);
+}
+
+static void ota_put_be16(uint8_t *p, uint16_t v)
+{
+    p[0] = (uint8_t)(v >> 8);
+    p[1] = (uint8_t)v;
+}
+
+static void ota_put_be32(uint8_t *p, uint32_t v)
+{
+    p[0] = (uint8_t)(v >> 24);
+    p[1] = (uint8_t)(v >> 16);
+    p[2] = (uint8_t)(v >> 8);
+    p[3] = (uint8_t)v;
+}
+
+static uint16_t ota_crc16_ccitt(const uint8_t *data, uint16_t len)
+{
+    uint16_t crc = 0xFFFFu;
+    uint16_t i;
+    uint8_t bit;
+
+    for (i = 0u; i < len; i++) {
+        crc ^= (uint16_t)data[i] << 8;
+        for (bit = 0u; bit < 8u; bit++) {
+            if ((crc & 0x8000u) != 0u) {
+                crc = (uint16_t)((crc << 1) ^ 0x1021u);
+            } else {
+                crc <<= 1;
+            }
+        }
+    }
+    return crc;
+}
+
+static uint32_t ota_crc32_update(uint32_t crc, const uint8_t *data, uint32_t len)
+{
+    uint32_t i;
+    uint8_t bit;
+
+    crc = ~crc;
+    for (i = 0u; i < len; i++) {
+        crc ^= data[i];
+        for (bit = 0u; bit < 8u; bit++) {
+            if ((crc & 1u) != 0u) {
+                crc = (crc >> 1) ^ 0xEDB88320UL;
+            } else {
+                crc >>= 1;
+            }
+        }
+    }
+    return ~crc;
+}
+
+static uint32_t ota_crc32(const uint8_t *data, uint32_t len)
+{
+    return ota_crc32_update(0u, data, len);
+}
+
+static uint8_t ota_is_flash_range(uint32_t addr, uint32_t size, uint32_t base, uint32_t limit_size)
+{
+    if (size == 0u) {
+        return 0u;
+    }
+    if (addr < base) {
+        return 0u;
+    }
+    if ((addr + size) < addr) {
+        return 0u;
+    }
+    if ((addr + size) > (base + limit_size)) {
+        return 0u;
+    }
+    return 1u;
+}
+
+static HAL_StatusTypeDef ota_flash_wait(void)
+{
+    while ((FLASH->SR & FLASH_SR_BSY) != 0u) {
+    }
+
+    if ((FLASH->SR & (FLASH_SR_PGERR | FLASH_SR_WRPERR)) != 0u) {
+        FLASH->SR = FLASH_SR_PGERR | FLASH_SR_WRPERR;
+        return HAL_ERROR;
+    }
+
+    if ((FLASH->SR & FLASH_SR_EOP) != 0u) {
+        FLASH->SR = FLASH_SR_EOP;
+    }
+    return HAL_OK;
+}
+
+static HAL_StatusTypeDef ota_flash_unlock(void)
+{
+    if ((FLASH->CR & FLASH_CR_LOCK) != 0u) {
+        FLASH->KEYR = FLASH_KEY1;
+        FLASH->KEYR = FLASH_KEY2;
+    }
+
+    if ((FLASH->CR & FLASH_CR_LOCK) != 0u) {
+        return HAL_ERROR;
+    }
+
+    FLASH->SR = FLASH_SR_EOP | FLASH_SR_PGERR | FLASH_SR_WRPERR;
+    return HAL_OK;
+}
+
+static void ota_flash_lock(void)
+{
+    FLASH->CR |= FLASH_CR_LOCK;
+}
+
+static HAL_StatusTypeDef ota_erase_pages(uint32_t addr, uint32_t size)
+{
+    uint32_t pages;
+    uint32_t page;
+    HAL_StatusTypeDef ret;
+
+    if ((addr % OTA_FLASH_PAGE_SIZE) != 0u) {
+        return HAL_ERROR;
+    }
+
+    pages = (size + OTA_FLASH_PAGE_SIZE - 1u) / OTA_FLASH_PAGE_SIZE;
+    for (page = 0u; page < pages; page++) {
+        ret = ota_flash_wait();
+        if (ret != HAL_OK) {
+            return ret;
+        }
+        FLASH->CR |= FLASH_CR_PER;
+        FLASH->AR = addr + (page * OTA_FLASH_PAGE_SIZE);
+        FLASH->CR |= FLASH_CR_STRT;
+        ret = ota_flash_wait();
+        FLASH->CR &= (uint32_t)~FLASH_CR_PER;
+        if (ret != HAL_OK) {
+            return ret;
+        }
+    }
+    return HAL_OK;
+}
+
+static HAL_StatusTypeDef ota_program_bytes(uint32_t addr, const uint8_t *data, uint32_t len)
+{
+    uint32_t i;
+    uint16_t halfword;
+    HAL_StatusTypeDef ret;
+
+    if ((addr & 1u) != 0u) {
+        return HAL_ERROR;
+    }
+
+    for (i = 0u; i < len; i += 2u) {
+        halfword = data[i];
+        if ((i + 1u) < len) {
+            halfword |= (uint16_t)data[i + 1u] << 8;
+        } else {
+            halfword |= 0xFF00u;
+        }
+
+        ret = ota_flash_wait();
+        if (ret != HAL_OK) {
+            return ret;
+        }
+        FLASH->CR |= FLASH_CR_PG;
+        *(__IO uint16_t *)(addr + i) = halfword;
+        ret = ota_flash_wait();
+        FLASH->CR &= (uint32_t)~FLASH_CR_PG;
+        if (ret != HAL_OK) {
+            return ret;
+        }
+    }
+    return HAL_OK;
+}
+
+static void ota_send_ack(uint8_t status)
+{
+    uint8_t tx[16];
+
+    s_ota.last_status = status;
+    tx[0] = WL_HEAD;
+    tx[1] = OTA_CMD_GROUP;
+    tx[2] = OTA_CMD_STATUS;
+    tx[3] = status;
+    ota_put_be16(&tx[4], s_ota.expected_seq);
+    ota_put_be32(&tx[6], s_ota.received_size);
+    tx[10] = (uint8_t)s_ota.state;
+    tx[11] = WL_TAIL;
+
+    HAL_UART_Transmit(&huart1, tx, 12u, 100u);
+}
+
+static HAL_StatusTypeDef ota_write_metadata(void)
+{
+    OTA_Metadata meta;
+    HAL_StatusTypeDef ret;
+
+    memset(&meta, 0xFF, sizeof(meta));
+    meta.magic = OTA_META_MAGIC;
+    meta.flags = OTA_META_FLAG_PENDING;
+    meta.image_addr = OTA_STAGING_BASE;
+    meta.image_size = s_ota.expected_size;
+    meta.image_crc32 = s_ota.expected_crc32;
+    meta.version = s_ota.version;
+    meta.reserved = 0u;
+    meta.metadata_crc32 = ota_crc32((const uint8_t *)&meta, sizeof(meta) - sizeof(meta.metadata_crc32));
+
+    ret = ota_flash_unlock();
+    if (ret == HAL_OK) {
+        ret = ota_erase_pages(OTA_METADATA_BASE, OTA_METADATA_SIZE);
+        if (ret == HAL_OK) {
+            ret = ota_program_bytes(OTA_METADATA_BASE, (const uint8_t *)&meta, sizeof(meta));
+        }
+    }
+    ota_flash_lock();
+
+    return ret;
+}
+
+static void ota_handle_start(const uint8_t *data, uint16_t len)
+{
+    HAL_StatusTypeDef ret;
+
+    /* FE 40 01 size[4] crc32[4] version[2] FF */
+    if (len != 14u) {
+        ota_send_ack(OTA_ACK_FORMAT_ERR);
+        return;
+    }
+
+    s_ota.expected_size = ota_read_be32(&data[3]);
+    s_ota.expected_crc32 = ota_read_be32(&data[7]);
+    s_ota.version = ota_read_be16(&data[11]);
+    s_ota.running_crc32 = 0u;
+    s_ota.received_size = 0u;
+    s_ota.expected_seq = 0u;
+
+    if ((s_ota.expected_size == 0u) || (s_ota.expected_size > OTA_STAGING_SIZE)) {
+        s_ota.state = OTA_STATE_FAILED;
+        ota_send_ack(OTA_ACK_SIZE_ERR);
+        return;
+    }
+
+    ret = ota_flash_unlock();
+    if (ret == HAL_OK) {
+        ret = ota_erase_pages(OTA_STAGING_BASE, OTA_STAGING_SIZE);
+        if (ret == HAL_OK) {
+            ret = ota_erase_pages(OTA_METADATA_BASE, OTA_METADATA_SIZE);
+        }
+    }
+    ota_flash_lock();
+
+    if (ret != HAL_OK) {
+        s_ota.state = OTA_STATE_FAILED;
+        ota_send_ack(OTA_ACK_FLASH_ERR);
+        return;
+    }
+
+    s_ota.state = OTA_STATE_RECEIVING;
+    ota_send_ack(OTA_ACK_OK);
+}
+
+static void ota_handle_data(const uint8_t *data, uint16_t len)
+{
+    uint16_t seq;
+    uint32_t offset;
+    uint16_t data_len;
+    uint16_t crc_rx;
+    uint16_t crc_calc;
+    HAL_StatusTypeDef ret;
+
+    if (s_ota.state != OTA_STATE_RECEIVING) {
+        ota_send_ack(OTA_ACK_STATE_ERR);
+        return;
+    }
+
+    if (len < 14u) {
+        ota_send_ack(OTA_ACK_FORMAT_ERR);
+        return;
+    }
+
+    seq = ota_read_be16(&data[3]);
+    offset = ota_read_be32(&data[5]);
+    data_len = ota_read_be16(&data[9]);
+
+    if (len != (uint16_t)(14u + data_len)) {
+        ota_send_ack(OTA_ACK_FORMAT_ERR);
+        return;
+    }
+
+    if ((seq != s_ota.expected_seq) || (offset != s_ota.received_size)) {
+        ota_send_ack(OTA_ACK_SEQ_ERR);
+        return;
+    }
+
+    if ((offset + data_len) > s_ota.expected_size) {
+        s_ota.state = OTA_STATE_FAILED;
+        ota_send_ack(OTA_ACK_SIZE_ERR);
+        return;
+    }
+
+    crc_rx = ota_read_be16(&data[11u + data_len]);
+    crc_calc = ota_crc16_ccitt(&data[3], (uint16_t)(8u + data_len));
+    if (crc_rx != crc_calc) {
+        ota_send_ack(OTA_ACK_CRC_ERR);
+        return;
+    }
+
+    ret = ota_flash_unlock();
+    if (ret == HAL_OK) {
+        ret = ota_program_bytes(OTA_STAGING_BASE + offset, &data[11], data_len);
+    }
+    ota_flash_lock();
+
+    if (ret != HAL_OK) {
+        s_ota.state = OTA_STATE_FAILED;
+        ota_send_ack(OTA_ACK_FLASH_ERR);
+        return;
+    }
+
+    s_ota.running_crc32 = ota_crc32_update(s_ota.running_crc32, &data[11], data_len);
+    s_ota.received_size += data_len;
+    s_ota.expected_seq++;
+    ota_send_ack(OTA_ACK_OK);
+}
+
+static void ota_handle_finish(const uint8_t *data, uint16_t len)
+{
+    uint32_t crc;
+
+    /* FE 40 03 crc32[4] FF */
+    if (len != 8u) {
+        ota_send_ack(OTA_ACK_FORMAT_ERR);
+        return;
+    }
+
+    if (s_ota.state != OTA_STATE_RECEIVING) {
+        ota_send_ack(OTA_ACK_STATE_ERR);
+        return;
+    }
+
+    crc = ota_read_be32(&data[3]);
+    if ((s_ota.received_size != s_ota.expected_size) ||
+        (crc != s_ota.expected_crc32) ||
+        (s_ota.running_crc32 != s_ota.expected_crc32)) {
+        s_ota.state = OTA_STATE_FAILED;
+        ota_send_ack(OTA_ACK_CRC_ERR);
+        return;
+    }
+
+    if (ota_write_metadata() != HAL_OK) {
+        s_ota.state = OTA_STATE_FAILED;
+        ota_send_ack(OTA_ACK_FLASH_ERR);
+        return;
+    }
+
+    s_ota.state = OTA_STATE_READY;
+    ota_send_ack(OTA_ACK_OK);
+    HAL_Delay(100u);
+    NVIC_SystemReset();
+}
+
+static void ota_handle_abort(void)
+{
+    s_ota.state = OTA_STATE_IDLE;
+    s_ota.expected_size = 0u;
+    s_ota.expected_crc32 = 0u;
+    s_ota.running_crc32 = 0u;
+    s_ota.received_size = 0u;
+    s_ota.expected_seq = 0u;
+    ota_send_ack(OTA_ACK_OK);
+}
+
+void OTA_Init(void)
+{
+    memset(&s_ota, 0, sizeof(s_ota));
+    s_ota.state = OTA_STATE_IDLE;
+}
+
+uint8_t OTA_IsFrame(const uint8_t *data, uint16_t len)
+{
+    if ((data == NULL) || (len < 4u)) {
+        return 0u;
+    }
+    if ((data[0] == WL_HEAD) && (data[1] == OTA_CMD_GROUP) && (data[len - 1u] == WL_TAIL)) {
+        return 1u;
+    }
+    return 0u;
+}
+
+void OTA_HandleFrame(const uint8_t *data, uint16_t len)
+{
+    if (OTA_IsFrame(data, len) == 0u) {
+        return;
+    }
+
+    if (ota_is_flash_range(OTA_STAGING_BASE, OTA_STAGING_SIZE, OTA_FLASH_BASE, OTA_FLASH_SIZE) == 0u) {
+        s_ota.state = OTA_STATE_FAILED;
+        ota_send_ack(OTA_ACK_FLASH_ERR);
+        return;
+    }
+
+    switch (data[2])
+    {
+        case OTA_CMD_START:
+            ota_handle_start(data, len);
+            break;
+        case OTA_CMD_DATA:
+            ota_handle_data(data, len);
+            break;
+        case OTA_CMD_FINISH:
+            ota_handle_finish(data, len);
+            break;
+        case OTA_CMD_STATUS:
+            ota_send_ack(s_ota.last_status);
+            break;
+        case OTA_CMD_ABORT:
+            ota_handle_abort();
+            break;
+        default:
+            ota_send_ack(OTA_ACK_FORMAT_ERR);
+            break;
+    }
+}
+
+OTA_State OTA_GetState(void)
+{
+    return s_ota.state;
+}
